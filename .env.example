# ==========================================================================
# Configuration de l'Espace Collaboratif Insuffle
# Copiez ce fichier en `.env` puis ajustez les valeurs : cp .env.example .env
# ==========================================================================

# Port d'écoute du serveur HTTP.
# Par défaut : 3000 — l'application sera accessible sur http://localhost:3000
PORT=3000

# Liste blanche d'origines autorisées pour CORS, séparées par des virgules.
# - En développement : laissez vide pour autoriser toutes les origines ('*').
# - En production : renseignez les domaines EXACTS de votre client.
#   Exemple : CLIENT_ORIGIN=https://espace.insuffle.com,https://insuffle.com
CLIENT_ORIGIN=
